---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const features = await getCollection('features');
const pricingTiers = (await getCollection('pricing')).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const useCases = (await getCollection('useCases')).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const proofs = (await getCollection('proofs')).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const howItWorks = (await getCollection('howItWorks')).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const shippedFeatures = features.filter((f) => f.data.status === 'shipped');
const upcomingFeatures = features.filter((f) => f.data.status === 'alpha' || f.data.status === 'beta' || f.data.status === 'planned');
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="section border-b border-outline bg-surface-elevated overflow-hidden">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto mb-16">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-2 py-1 mb-6 rounded-sm bg-surface border border-outline font-mono text-xs text-content-muted">
            <span class="w-2 h-2 rounded bg-secondary"></span>
            <span>Real Shopfloor Truth. No ₹50L Project.</span>
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 text-content leading-tight">
            OEE, Downtime, Traceability & Compliance <br class="hidden sm:block" /><span class="text-primary">— Deployed in 4 Hours</span>
          </h1>

          <p class="text-lg sm:text-xl text-content-muted leading-relaxed mb-8 max-w-2xl">
            Single binary. Runs offline. Hindi, தமிழ், తెలుగు, ಕನ್ನಡ, मराठी on the tablet. Core free forever. Pro ₹59,990/plant/yr flat. Pass IATF 16949 & AS9100 without the enterprise price tag.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a href="/contact" class="btn-primary font-medium text-sm">
              Inquire for Pilot & Demo
            </a>
            <a href="/demo" class="btn-secondary font-medium text-sm">
              Explore Product Tour
            </a>
            <a href="mailto:contact-us@kaarya.interstellarhq.in?subject=Technical%20Walkthrough%20Request" class="font-sans text-sm text-content-muted hover:text-primary transition-colors underline underline-offset-4">
              Request 30-min Walkthrough
            </a>
          </div>

          <!-- Trust Signals -->
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-content-muted">
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Trusted in Pune, Bengaluru, Coimbatore</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Air-gap native execution</span>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <!-- Terminal Widget -->
          <div class="rounded-lg border border-outline bg-surface overflow-hidden shadow-2xl relative z-10">
            <div class="flex items-center gap-2 px-4 py-2 border-b border-outline bg-surface-elevated">
              <div class="w-3 h-3 rounded-full bg-error"></div>
              <div class="w-3 h-3 rounded-full bg-warning"></div>
              <div class="w-3 h-3 rounded-full bg-secondary"></div>
              <div class="ml-2 font-mono text-xs text-content-muted">kaarya-node-1 ~ production</div>
            </div>
            <div class="p-6 font-mono text-sm leading-relaxed">
              <div class="text-content-muted mb-2">$ kaarya status --live</div>
              <div class="mb-4">
                <span class="text-secondary">[OK]</span> Node <span class="text-primary">CNC-01</span> online.<br/>
                <span class="text-secondary">[OK]</span> Syncing telemetry... 14ms ping.
              </div>
              <div class="mb-2">CURRENT RUN: <span class="text-content font-bold">WO-9921-B</span></div>
              <div class="grid grid-cols-2 gap-4 border border-outline p-3 rounded-sm bg-surface-elevated mb-4">
                <div>
                  <div class="text-xs text-content-muted mb-1">OEE</div>
                  <div class="text-2xl text-secondary font-bold">87.4%</div>
                </div>
                <div>
                  <div class="text-xs text-content-muted mb-1">CYCLE TIME</div>
                  <div class="text-2xl text-primary font-bold">42s</div>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-content-muted">Local DB: <span class="text-content">WAL Sync</span></span>
                <span class="text-secondary animate-pulse">● LIVE</span>
              </div>
            </div>
          </div>
          <!-- Decorative background glow -->
          <div class="absolute -top-10 -right-10 w-64 h-64 bg-primary/20 rounded-full blur-3xl z-0 pointer-events-none"></div>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="metric-strip">
        <div class="metric-strip-item">
          <div class="font-mono text-3xl font-bold text-primary mb-1">4 hrs</div>
          <div class="font-sans text-sm text-content-muted font-medium">Deploy to Live OEE</div>
        </div>
        <div class="metric-strip-item">
          <div class="font-mono text-3xl font-bold text-status-shipped mb-1">Free</div>
          <div class="font-sans text-sm text-content-muted font-medium">Core Tier (Single PC)</div>
        </div>
        <div class="metric-strip-item">
          <div class="font-mono text-3xl font-bold text-content mb-1">8</div>
          <div class="font-sans text-sm text-content-muted font-medium">Indian Languages Native</div>
        </div>
        <div class="metric-strip-item">
          <div class="font-mono text-3xl font-bold text-primary mb-1">₹59.9k</div>
          <div class="font-sans text-sm text-content-muted font-medium">/plant/yr Flat Pro</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Shipped Features Section -->
  <section id="features" class="section border-b border-outline">
    <div class="container">
      <div class="mb-12">
        <div class="section-label">General Availability</div>
        <h2 class="text-3xl font-bold tracking-tight mb-2">Production-Ready Capabilities</h2>
        <p class="text-content-muted max-w-2xl">
          Battle-tested on factory shopfloors. Available in the single desktop binary and API server today.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {shippedFeatures.map((feature) => (
          <div class="card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-sans text-xs font-bold text-primary uppercase tracking-wider">
                  {feature.data.category}
                </span>
                <div class="flex items-center gap-2">
                  <span class="badge-shipped">Shipped</span>
                  <span class={feature.data.tier === 'pro' ? 'badge-pro' : 'badge-core'}>
                    {feature.data.tier}
                  </span>
                </div>
              </div>
              <h3 class="text-xl font-bold mb-2">{feature.data.title}</h3>
              <p class="text-sm text-content-muted mb-4">{feature.data.tagline}</p>
              <p class="text-sm leading-relaxed mb-4">{feature.data.description}</p>
            </div>

            <div class="pt-4 border-t border-outline">
              <div class="font-mono text-xs text-content-muted flex flex-wrap gap-2">
                {feature.data.keywords.map((kw) => (
                  <span class="px-2 py-0.5 rounded bg-surface border border-outline">
                    {kw}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Use Cases / Verticals -->
      <div class="mt-16">
        <h3 class="text-2xl font-bold tracking-tight mb-6 text-center">Built for Indian Manufacturing Segments</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {useCases.map((uc) => (
            <div class="use-case-row">
              <div class="font-display text-lg font-bold text-content mb-1">{uc.data.title}</div>
              <p class="text-sm text-content-muted">{uc.data.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming Features Section (Alpha & Beta Modes) -->
  <section id="upcoming" class="section bg-surface-elevated border-b border-outline">
    <div class="container">
      <div class="mb-12">
        <div class="section-label">Roadmap & Pilot Testing</div>
        <h2 class="text-3xl font-bold tracking-tight mb-2">Upcoming Features: Alpha & Beta Modes</h2>
        <p class="text-content-muted max-w-2xl">
          We explicitly disclose upcoming capabilities, companion apps, and prototype stages. Features tagged with <strong class="text-status-alpha">Alpha Mode</strong> are in architectural prototyping, while <strong class="text-status-beta">Beta Mode</strong> capabilities (including our CNC & PLC IoT Automation Gateway and Mobile Floor Companion) are in active shopfloor pilot validation on physical machines. Our core software capabilities—including OEE calculation, downtime reasoning, shift handovers, and compliance dossiers—are fully stable and production-proven.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {upcomingFeatures.map((feature) => (
          <div class="upcoming-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-sans text-xs font-bold text-primary uppercase tracking-wider">
                  {feature.data.category}
                </span>
                <div class="flex items-center gap-2">
                  {feature.data.status === 'alpha' && <span class="badge-alpha">Alpha Mode</span>}
                  {feature.data.status === 'beta' && <span class="badge-beta">Beta Mode</span>}
                  {feature.data.status === 'planned' && <span class="badge-core">Planned</span>}
                  <span class={feature.data.tier === 'pro' ? 'badge-pro' : feature.data.tier === 'cloud' ? 'badge-beta' : 'badge-core'}>
                    {feature.data.tier}
                  </span>
                </div>
              </div>
              <h3 class="text-xl font-bold mb-2">{feature.data.title}</h3>
              <p class="text-sm text-content-muted mb-4">{feature.data.tagline}</p>
              <p class="text-sm leading-relaxed mb-4">{feature.data.description}</p>
            </div>

            <div class="pt-4 border-t border-outline">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-content-muted">Version: {feature.data.version}</span>
                <div class="font-mono text-xs text-content-muted flex flex-wrap gap-1">
                  {feature.data.keywords.slice(0, 3).map((kw) => (
                    <span class="px-2 py-0.5 rounded bg-surface border border-outline">
                      {kw}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Customer Proof Section -->
  <section id="proof" class="section border-b border-outline">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold tracking-tight mb-2">Not Marketing Claims. Shopfloor Receipts.</h2>
        <p class="text-content-muted">
          Real deployments. Real compliance outcomes. Real ₹ impact.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {proofs.map((proof) => (
          <div class="card p-6 flex flex-col justify-between">
            <div>
              <div class="font-sans text-xs font-semibold text-content-muted mb-2 uppercase tracking-wider">{proof.data.location} • {proof.data.industry}</div>
              <h3 class="text-lg font-bold mb-2">{proof.data.title}</h3>
              <p class="text-sm text-content-muted mb-4">{proof.data.description}</p>
            </div>
            <div class="font-display text-xl text-secondary font-bold pt-4 border-t border-outline">{proof.data.highlight}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="section bg-surface-elevated border-b border-outline">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold tracking-tight mb-2">4 Hours to Live OEE</h2>
        <p class="text-content-muted">
          No PLC changes. No SCADA. No consultants. Just a binary and your existing network.
        </p>
      </div>

      <div class="max-w-4xl mx-auto pl-4">
        {howItWorks.map((step) => (
          <div class="timeline-step">
            <div class="font-mono text-xl font-bold text-primary mb-2">{step.data.time}</div>
            <h3 class="text-lg font-bold mb-2">{step.data.title}</h3>
            <p class="text-sm text-content-muted">
              {step.data.description}
              {step.data.codeSnippet && (
                <code class="font-mono bg-surface px-1.5 py-0.5 rounded border border-outline mt-2 block w-fit">{step.data.codeSnippet}</code>
              )}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/demo" class="btn-secondary font-medium text-sm inline-flex items-center gap-2">
          Explore Interactive Product Tour
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 7l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="section">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold tracking-tight mb-2">Transparent Pricing. Engineered for Indian MSMEs.</h2>
        <p class="text-content-muted">
          Core free forever (up to 2 machines). Pro Starter from ₹24,990/yr (Tally-aligned). Zero per-seat fees.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-16">
        {pricingTiers.map((tier) => (
          <div class={`card flex flex-col justify-between relative ${tier.data.highlight ? 'border-primary shadow-md' : ''}`}>
            {tier.data.highlight && (
              <div class="absolute -top-3 right-4 font-mono text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-primary text-white">
                Most Popular
              </div>
            )}
            <div>
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-bold">{tier.data.name}</h3>
                <span class={tier.data.id === 'pro' ? 'badge-pro' : tier.data.id === 'cloud' ? 'badge-beta' : 'badge-core'}>
                  {tier.data.id}
                </span>
              </div>
              <div class="mb-4">
                {tier.data.price_annual_inr !== null && tier.data.price_annual_inr !== undefined && tier.data.price_annual_inr > 0 ? (
                  <>
                    <span class="font-mono text-3xl font-bold text-content">
                      ₹{tier.data.price_annual_inr.toLocaleString('en-IN')}
                    </span>
                    <span class="text-xs text-content-muted font-mono">
                      /yr
                    </span>
                  </>
                ) : (
                  <div class="font-mono text-3xl font-bold text-status-shipped">
                    Free Forever
                  </div>
                )}
                {tier.data.price_monthly_inr && tier.data.price_annual_inr && tier.data.price_annual_inr > 0 && (
                  <div class="text-xs text-content-muted font-mono mt-1">
                    (₹{tier.data.price_monthly_inr.toLocaleString('en-IN')}/mo equivalent)
                  </div>
                )}
              </div>
              <p class="text-sm text-content-muted mb-6">{tier.data.description}</p>

              <div class="space-y-2 border-t border-outline pt-4 mb-6">
                <div class="font-mono text-xs font-semibold text-content-muted uppercase tracking-wider mb-2">Includes</div>
                <ul class="space-y-1 text-sm">
                  {tier.data.features.map((feat) => (
                    <li class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <a 
                href={`/contact?tier=${tier.data.id}`}
                class={`${tier.data.highlight ? 'btn-primary' : 'btn-secondary'} w-full text-center text-sm`}
              >
                {tier.data.id === 'core' ? 'Inquire for Core Access' : tier.data.id === 'pro' ? 'Inquire for Pro Pilot' : 'Contact Sales for Cloud'}
              </a>
              
              {tier.data.id === 'pro' && (
                <div class="font-mono text-xs text-center text-primary font-semibold">
                  Flat plant license · Unlimited machines
                </div>
              )}

              <a href="#tier-specs" class="font-sans text-xs text-center font-semibold text-content-muted hover:text-primary block transition-colors">
                View {tier.data.name} Specifications
              </a>
            </div>
          </div>
        ))}
      </div>

<!-- Detailed Tier Specifications & Comparison Matrix -->
      <div id="tier-specs" class="max-w-4xl mx-auto pt-8 border-t border-outline">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold tracking-tight mb-2">Tier Architectural Specifications</h3>
          <p class="text-sm text-content-muted">
            Detailed technical capabilities and limits for engineering evaluators.
          </p>
        </div>

        <div class="overflow-x-auto rounded-lg border border-outline bg-surface-elevated">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-outline bg-surface font-sans text-sm font-semibold text-content-muted">
                <th class="p-4">Capability / Dimension</th>
                <th class="p-4 w-44">Core Edition</th>
                <th class="p-4 w-44 text-primary">Pro Edition</th>
                <th class="p-4 w-44 text-status-beta">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline">
              <tr>
                <td class="p-4 font-medium">Machine & Shift Capacity</td>
                <td class="p-4 font-mono">Up to 2 machines (evaluation)</td>
                <td class="p-4 font-mono font-bold text-primary">Unlimited machines · Unlimited shifts</td>
                <td class="p-4 font-mono text-status-beta">Unlimited machines (multi-plant)</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Annual License Price</td>
                <td class="p-4 font-mono font-bold text-status-shipped">Free Forever</td>
                <td class="p-4 font-mono font-bold text-primary">₹59,990 / plant / yr (flat)</td>
                <td class="p-4 font-mono text-status-beta">₹99,990 / plant / yr</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Real-Time OEE & TEEP Engine</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Manual Entry</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Auto (PLC) + Manual</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Auto (PLC) + Manual</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">PLC Connectivity (Modbus, OPC UA, MQTT Sparkplug B)</td>
                <td class="p-4 font-mono text-content-muted">— (Core = Manual only)</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Auto-telemetry</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Auto-telemetry</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Multi-Shift Comparison</td>
                <td class="p-4 font-mono text-content-muted">— (1 shift only)</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Unlimited shifts</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Unlimited shifts</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Downtime Pareto & Scrap Pareto</td>
                <td class="p-4 font-mono">Manual categorization</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Auto + Manual</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Auto + Manual</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Worker Efficiency & TEEP / Capacity</td>
                <td class="p-4 font-mono text-content-muted">—</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Included</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Included</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Compliance Reports (PDF GST, Excel, Scheduled)</td>
                <td class="p-4 font-mono">CSV export only</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ PDF + Excel + Scheduled</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ + Multi-plant Rollup</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Mobile Floor Companion</td>
                <td class="p-4 font-mono">Android / iOS / PWA (Operator)</td>
                <td class="p-4 font-mono font-bold">Operator + Supervisor</td>
                <td class="p-4 font-mono font-bold">All + Custom Workflows</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Downtime Reasoning (35 codes, 8 languages, voice)</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Included</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ + Custom, ML, MTTR/MTBF</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ + Predictive Hooks</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Shift Handover</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Digital, Signed, PDF</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ + AI Summary, KPI Compare</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ + Escalation Tracking</td>
              </tr>
              <tr>
                <td class="p-4 font-medium">Multi-Plant Support</td>
                <td class="p-4 font-mono text-content-muted">—</td>
                <td class="p-4 font-mono text-content-muted">— (1 plant)</td>
                <td class="p-4 font-mono text-status-shipped font-bold">✓ Unlimited</td>
              </tr>
              <tr>
