---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const features = await getCollection('features');
const proofs = await getCollection('proofs');
const howItWorks = await getCollection('howItWorks');

const heroFeatures = features.filter((f) => f.data.status === 'shipped').slice(0, 4);
const topProofs = proofs.slice(0, 2);
---

<BaseLayout>
  <!-- HERO -->
  <section class="section border-b border-outline bg-surface-elevated overflow-hidden">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-sm bg-primary-subtle border border-primary-border font-mono text-xs text-primary font-semibold">
            <span class="w-2 h-2 rounded bg-primary animate-pulse"></span>
            <span>🇮🇳 100% MADE IN INDIA · RUNS 100% OFFLINE ON YOUR LAN</span>
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-6 text-content leading-tight">
            Cut Machine Downtime 20% in 4 Hours.<br class="hidden sm:block" /><span class="text-primary">No PLC Changes. No Consultants.</span>
          </h1>

          <p class="text-lg sm:text-xl text-content-muted leading-relaxed mb-8 max-w-2xl">
            Single binary. Free for 2 machines forever. ₹24,990/yr flat — unlimited machines, unlimited shifts. Hindi, தமிழ், తెలుగు, ಕನ್ನಡ, मराठी on every operator tablet.
          </p>

          <div class="flex flex-wrap items-center gap-4 mb-8">
            <a href="/contact" class="btn-primary font-medium text-sm" data-testid="hero-cta-primary">
              Start Free Pilot
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 7l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <!-- Trust Strip -->
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-content-muted">
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Running on 50+ machines across Pune, Bengaluru, Coimbatore, Rajkot</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Air-gap native · Zero internet required</span>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <!-- KPI Illustration -->
          <div class="rounded-lg border border-outline bg-surface overflow-hidden shadow-2xl relative z-10">
            <div class="p-6 space-y-4">
              <div class="grid grid-cols-3 gap-4 text-center">
                <div class="p-3 rounded-lg bg-surface-elevated border border-outline">
                  <div class="text-3xl font-bold font-mono text-secondary">87%</div>
                  <div class="text-xs text-content-muted font-sans mt-1">OEE</div>
                </div>
                <div class="p-3 rounded-lg bg-surface-elevated border border-outline">
                  <div class="text-3xl font-bold font-mono text-primary">42s</div>
                  <div class="text-xs text-content-muted font-sans mt-1">Cycle Time</div>
                </div>
                <div class="p-3 rounded-lg bg-surface-elevated border border-outline">
                  <div class="text-3xl font-bold font-mono text-warning">20%</div>
                  <div class="text-xs text-content-muted font-sans mt-1">Downtime Cut</div>
                </div>
              </div>
              <div class="p-3 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center gap-2">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                <span class="font-mono text-xs text-primary font-semibold">LIVE — Real-time data from shopfloor</span>
              </div>
            </div>
          </div>
          <div class="absolute -top-10 -right-10 w-64 h-64 bg-primary/20 rounded-full blur-3xl z-0 pointer-events-none"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section class="section border-b border-outline bg-surface-elevated/50">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {topProofs.map((proof) => (
          <div class="card p-6 border-l-4 border-primary">
            <div class="font-sans text-xs font-semibold text-content-muted mb-1 uppercase tracking-wider">{proof.data.location} · {proof.data.industry}</div>
            <h3 class="text-lg font-bold mb-2">{proof.data.title}</h3>
            <p class="text-sm text-content-muted mb-3">{proof.data.description}</p>
            <div class="font-display text-xl text-secondary font-bold">{proof.data.highlight}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUTCOME PILLARS (3 core outcomes) -->
  <section id="features" class="section border-b border-outline">
    <div class="container">
      <div class="mb-12">
        <div class="section-label">What You Get</div>
        <h2 class="text-3xl font-bold tracking-tight mb-2">Three Outcomes That Matter</h2>
        <p class="text-content-muted max-w-2xl">No feature bloat. Just the three things every plant manager needs to run a better shopfloor.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Pillar 1: See Everything -->
        <div class="outcome-pillar">
          <div class="outcome-pillar-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="outcome-pillar-title">See Everything</h3>
          <p class="outcome-pillar-desc">Live Andon board + real-time OEE on every screen. Wall TVs, tablets, phones — sub-500ms latency. Know instantly which machine is running, down, or idle.</p>
        </div>

        <!-- Pillar 2: Log Everything -->
        <div class="outcome-pillar">
          <div class="outcome-pillar-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="outcome-pillar-title">Log Everything</h3>
          <p class="outcome-pillar-desc">Operators log downtime in 3 taps — in Hindi, Tamil, Telugu, Kannada, Marathi, or voice. Mandatory reason gate means no blank downtime. Pareto updates every 10 seconds.</p>
        </div>

        <!-- Pillar 3: Report Everything -->
        <div class="outcome-pillar">
          <div class="outcome-pillar-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="outcome-pillar-title">Report Everything</h3>
          <p class="outcome-pillar-desc">One-click shift dossiers, GST-ready PDFs, Excel exports, scheduled emails. IATF 16949 audit packets generated automatically. No more clipboard disputes.</p>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href="/features" class="btn-secondary font-medium text-sm inline-flex items-center gap-2">
          View All 14 Capabilities
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 7l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS - 3 Steps -->
  <section id="how-it-works" class="section bg-surface-elevated border-b border-outline">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold tracking-tight mb-2">4 Hours to Live OEE</h2>
        <p class="text-content-muted">No PLC changes. No SCADA. No consultants. Just a binary and your existing network.</p>
      </div>

      <div class="max-w-4xl mx-auto pl-4">
        {howItWorks.slice(0, 3).map((step, index) => (
          <div class="step-timeline">
            <span class="step-timeline-marker">{index + 1}</span>
            <div class="step-timeline-content">
              <h3 class="step-timeline-title">{step.data.title}</h3>
              <p class="step-timeline-desc">{step.data.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/demo" class="btn-secondary font-medium text-sm inline-flex items-center gap-2">
          Explore Interactive Product Tour
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 7l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PRICING - 2 Tiers + Contact Sales -->
  <section id="pricing" class="section">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold tracking-tight mb-2">Transparent Pricing. Engineered for Indian MSMEs.</h2>
        <p class="text-content-muted">Core free forever (2 machines). Pro ₹24,990/yr flat — unlimited machines. Zero per-seat fees.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto mb-16">
        <!-- Core Tier -->
        <div class="pricing-card">
          <div>
            <h3 class="pricing-name">Core</h3>
            <div class="pricing-price free">Free<span class="period">/yr</span></div>
            <p class="pricing-tagline">Free forever for up to 2 machines — perfect for evaluation</p>
            <ul class="pricing-features">
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Up to 2 machines, 1 shift</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Manual OEE entry</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Downtime reasoning (35 codes, 8 languages, voice)</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Shift handover (digital, signed, PDF)</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> CSV export</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Android / iOS / PWA operator app</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> 100% offline LAN execution</li>
            </ul>
            <div class="pricing-cta">
              <a href="/contact?tier=core" class="btn-primary w-full text-sm py-2.5">
                Get Core Free
              </a>
            </div>
          </div>
        </div>

        <!-- Pro Tier -->
        <div class="pricing-card highlighted relative">
          <div class="pricing-badge">Most Popular</div>
          <div>
            <h3 class="pricing-name">Pro</h3>
            <div class="pricing-price">₹24,990<span class="period">/yr</span></div>
            <p class="pricing-tagline">Flat plant license — unlimited machines, unlimited shifts</p>
            <ul class="pricing-features">
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Unlimited machines & shifts</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Auto OEE from PLC (Modbus, OPC UA, MQTT)</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Auto + Manual downtime categorization</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Worker efficiency & TEEP / Capacity</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> PDF + Excel + Scheduled compliance reports</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Operator + Supervisor mobile apps</li>
              <li><svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Guided pilot (2 weeks)</li>
            </ul>
            <div class="pricing-cta">
              <a href="/contact?tier=pro" class="btn-primary w-full text-sm py-2.5">
                Start Pro Pilot
              </a>
              <div class="pricing-note">Flat plant license · Unlimited machines</div>
              <a href="/specs" class="pricing-specs-link">View Technical Specifications</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Enterprise - Contact Sales -->
      <div class="text-center max-w-xl mx-auto">
        <div class="card p-8 max-w-xl mx-auto">
          <h3 class="text-2xl font-bold mb-2">Enterprise</h3>
          <p class="text-content-muted mb-6">Multi-plant rollups, SSO/RBAC, audit trails, custom workflows, priority SLA, assisted rollout.</p>
          <div class="pricing-price">₹99,990<span class="period">/yr</span></div>
          <p class="text-xs text-content-muted font-mono mt-1">(per plant)</p>
          <a href="/contact?tier=enterprise" class="btn-secondary w-full text-sm py-2.5 mt-6 inline-block">
            Contact Sales
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER CTA BAND -->
  <section class="section bg-primary text-white">
    <div class="container text-center">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">Ready to Cut Downtime 20%?</h2>
      <p class="text-primary-100 mb-6 max-w-xl mx-auto">Book a 30-minute technical walkthrough. We'll show you live OEE on your machine — no commitment.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary font-medium rounded-sm hover:bg-primary-50 transition-colors">
        Start Free Pilot
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 7l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
