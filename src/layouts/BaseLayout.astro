---
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  keywords?: string[];
}

const {
  title = 'कार्य (Kaarya) — Digital Shopfloor Ledger & Industrial MES for Indian Manufacturing',
  description = 'Local-first, air-gapped manufacturing operations management and live OEE tracking for CNC machine shops and MSMEs. Zero per-seat fee, Hindi/Tamil/Telugu/Kannada/Marathi operator UI, IATF 16949 audit ready.',
  ogImage = '/images/og-default.png',
  keywords = [
    'OEE Software India',
    'Digital Shopfloor Ledger',
    'Manufacturing Execution System India',
    'CNC Machine Monitoring',
    'Air-gapped MES',
    'Industrial IoT Gateway',
    'Downtime Tracking',
    'Shift Handover Software',
    'IATF 16949 Compliance',
    'MSME Manufacturing Software',
    'Kaarya MES',
    'kaayra',
  ],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kaayra.interstellarhq.in').toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Kaarya (कार्य)',
      operatingSystem: 'Windows, Linux, macOS, Android, iOS',
      applicationCategory: 'ManufacturingOperationsManagement',
      applicationSubCategory: 'Shopfloor Execution & OEE Ledger',
      description: description,
      url: 'https://kaayra.interstellarhq.in',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'INR',
        description: 'Core edition free forever for up to 2 machines; Pro flat annual plant license.',
      },
      featureList: [
        'Real-time OEE Engine (Availability, Performance, Quality, TEEP)',
        'Operator Downtime Reasoning with Vernacular & Voice Support',
        'Digital Shift Handover with Auto-PDF Dossiers',
        'Air-Gapped Offline Single Binary Execution',
        'Batch & Part Traceability for IATF 16949 and AS9100',
        'CNC & PLC Telemetry Gateway (Beta)',
      ],
    },
    {
      '@type': 'Organization',
      name: 'Kaarya Manufacturing Systems',
      url: 'https://kaayra.interstellarhq.in',
      email: 'contact-us@kaarya.interstellarhq.in',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'contact-us@kaarya.interstellarhq.in',
        contactType: 'sales and technical support',
        availableLanguage: ['English', 'Hindi', 'Tamil', 'Telugu', 'Kannada', 'Marathi'],
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1326" />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Kaarya Manufacturing Systems" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: ogImage,
          url: canonicalURL,
        },
        optional: {
          description: description,
          siteName: "Kaarya (कार्य)",
          locale: "en_IN",
        }
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: ogImage,
      }}
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-content">
    <header class="border-b border-outline bg-surface-elevated sticky top-0 z-40">
      <div class="container flex items-center justify-between h-16 px-4">
        <a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight text-content no-underline">
          <span class="px-2 h-7 rounded bg-primary text-white flex items-center justify-center text-sm font-bold">कार्य</span>
          <span>KAARYA</span>
        </a>
        <nav class="flex items-center gap-4 sm:gap-6 text-sm font-medium">
          <a href="/#features" class="text-content-muted hover:text-content no-underline transition-colors">Features</a>
          <a href="/demo" class="text-content-muted hover:text-content no-underline transition-colors flex items-center gap-1.5">
            <span>Demo</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-primary/20 text-primary uppercase font-bold">Tour</span>
          </a>
          <a href="/#upcoming" class="text-content-muted hover:text-content no-underline transition-colors hidden sm:inline">Roadmap</a>
          <a href="/#pricing" class="text-content-muted hover:text-content no-underline transition-colors">Pricing</a>
          <a href="/contact" class="btn-primary text-xs px-3.5 py-1.5 ml-1 sm:ml-2">Inquire & Book Demo</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-outline bg-surface-elevated py-12 text-sm text-content-muted">
      <div class="container px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 border-b border-outline pb-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 font-display text-xl font-bold tracking-tight text-content mb-4">
              <span class="px-2 h-7 rounded bg-primary text-white flex items-center justify-center text-sm font-bold">कार्य</span>
              <span>KAARYA</span>
            </div>
            <p class="max-w-xs text-sm mb-4">Digital Shopfloor Ledger & Industrial MES. High-precision OEE, downtime tracking, and shift management engineered for Indian manufacturing plants.</p>
            <div class="flex items-center gap-2 text-xs font-mono text-content-muted">
              <span>Direct Inquiries:</span>
              <a href="mailto:contact-us@kaarya.interstellarhq.in" class="text-primary hover:underline font-semibold">contact-us@kaarya.interstellarhq.in</a>
            </div>
          </div>
          <div>
            <h4 class="font-bold text-content mb-3">Product</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/#features" class="hover:text-primary transition-colors">Features & Capabilities</a></li>
              <li><a href="/demo" class="hover:text-primary transition-colors">Interactive Product Demo</a></li>
              <li><a href="/#pricing" class="hover:text-primary transition-colors">Transparent Pricing</a></li>
              <li><a href="/contact" class="hover:text-primary transition-colors">Request Pilot Access</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-content mb-3">Resources & Inquiries</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/contact" class="hover:text-primary transition-colors">Product Inquiries</a></li>
              <li><a href="/ai-manifest.json" target="_blank" class="hover:text-primary transition-colors flex items-center gap-1">AI Manifest <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a></li>
              <li><a href="mailto:contact-us@kaarya.interstellarhq.in" class="hover:text-primary transition-colors">contact-us@kaarya.interstellarhq.in</a></li>
            </ul>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="m-0 font-sans text-xs">© {new Date().getFullYear()} Kaarya Manufacturing Systems. All rights reserved.</p>
          <div class="flex items-center gap-4 text-xs">
            <span class="text-secondary font-medium">Air-Gap Native</span>
            <span class="text-outline">|</span>
            <span>Domain: kaayra.interstellarhq.in</span>
            <span class="text-outline">|</span>
            <span class="text-primary font-medium">Made for India</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
